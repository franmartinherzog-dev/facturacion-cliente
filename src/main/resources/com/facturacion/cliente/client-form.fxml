<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml" alignment="CENTER" spacing="12"
      fx:controller="com.facturacion.cliente.ClientFormController">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <Label fx:id="formTitle" styleClass="title"/>
    <TextField fx:id="nameField" promptText="Name" maxWidth="320"/>
    <TextField fx:id="taxIdField" promptText="Tax ID (NIF/CIF)" maxWidth="320"/>
    <TextField fx:id="addressField" promptText="Address (optional)" maxWidth="320"/>
    <TextField fx:id="emailField" promptText="Email (optional)" maxWidth="320"/>
    <TextField fx:id="phoneField" promptText="Phone (optional)" maxWidth="320"/>
    <Label fx:id="errorLabel" styleClass="error" wrapText="true" maxWidth="320"/>
    <HBox spacing="8" alignment="CENTER">
        <Button fx:id="saveButton" text="Save" defaultButton="true" onAction="#handleSave"/>
        <Button text="Cancel" cancelButton="true" onAction="#handleCancel"/>
    </HBox>
</VBox>