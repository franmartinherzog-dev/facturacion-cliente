<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml" alignment="CENTER" spacing="12"
      fx:controller="com.facturacion.cliente.RegisterController">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <Label text="Create account" styleClass="title"/>
    <TextField fx:id="usernameField" promptText="Username (3-50 characters)" maxWidth="320"/>
    <PasswordField fx:id="passwordField" promptText="Password (8-72 characters)" maxWidth="320"/>
    <TextField fx:id="companyNameField" promptText="Company name" maxWidth="320"/>
    <TextField fx:id="taxIdField" promptText="Tax ID (NIF/CIF)" maxWidth="320"/>
    <TextField fx:id="addressField" promptText="Address (optional)" maxWidth="320"/>
    <Label fx:id="errorLabel" styleClass="error" wrapText="true" maxWidth="320"/>
    <Button fx:id="registerButton" text="Register" defaultButton="true" onAction="#handleRegister"/>
    <Button text="Back to login" onAction="#handleBack"/>
</VBox>