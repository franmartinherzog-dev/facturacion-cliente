<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml" spacing="12"
      fx:controller="com.facturacion.cliente.InvoiceHistoryController">
    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>

    <HBox spacing="8">
        <Label text="Facturas emitidas" styleClass="title"/>
        <HBox HBox.hgrow="ALWAYS"/>
        <Button text="Nueva factura" onAction="#handleNew"/>
        <Button text="Descargar PDF" onAction="#handleDownload"/>
        <Button text="Volver a clientes" onAction="#handleBack"/>
    </HBox>

    <TableView fx:id="invoicesTable" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="numberColumn" text="Número" prefWidth="110"/>
            <TableColumn fx:id="dateColumn" text="Fecha" prefWidth="110"/>
            <TableColumn fx:id="clientColumn" text="Cliente" prefWidth="260"/>
            <TableColumn fx:id="totalColumn" text="Total" prefWidth="120"/>
        </columns>
    </TableView>

    <Label fx:id="statusLabel" styleClass="error"/>
</VBox>